rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin role
    function isAdmin() {
      return request.auth != null;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders and quotes
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || true;
    }

    // Delivery fleet
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if true;
    }

    // Freights & neighborhood table
    match /freights/{freightId} {
      allow read: if true;
      allow write: if true;
    }

    // Store settings
    match /storeConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin users
    match /adminUsers/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
